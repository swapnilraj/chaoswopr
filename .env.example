# chaoswopr LLM Configuration
# Copy this file to .env and fill in your values

# OpenRouter API key (get one at https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# LLM provider: openrouter, anthropic, or mock
CHAOSWOPR_LLM_PROVIDER=openrouter

# Set to true for dry-run mode (uses mock LLM, no real API calls)
CHAOSWOPR_DRY_RUN=false

# Models (OpenRouter model identifiers)
HYPOTHESIS_MODEL=anthropic/claude-opus-4
RCA_MODEL=anthropic/claude-sonnet-4.5

# OpenRouter settings
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=60
OPENROUTER_MAX_RETRIES=3

# Anthropic API key (only needed if using anthropic provider directly)
# ANTHROPIC_API_KEY=sk-ant-...
